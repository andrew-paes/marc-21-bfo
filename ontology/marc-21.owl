    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#loan_record</IRI>
        <Literal xml:lang="en-us">A MARC 21 record that has been textually modified in written form. It is not a free narrative document, but rather structured strings that carry information. An informational piece of log data or transaction record that permanently attests the historical loan transaction between a reader and an item.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#loan_record</IRI>
        <Literal xml:lang="pt-br">Um registro MARC 21 textualmente modificado de forma escrita. Não é documento narrativo livre, mas strings estruturadas que carregam informação. Um artefato informacional ou linha de log que atesta permanentemente a transação histórica de empréstimo ocorrida entre um leitor e um item.</Literal>
    </AnnotationAssertion>
