        <Literal xml:lang="pt-br">Dom Casmurro (Exemplar Físico de 1899)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#inst_Garnier_Publisher</IRI>
        <Literal xml:lang="pt-br">A tradicional casa editorial estabelecida no Rio de Janeiro.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#inst_Garnier_Publisher</IRI>
        <Literal xml:lang="en-us">The traditional publishing house established in Rio de Janeiro.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#inst_Garnier_Publisher</IRI>
        <Literal xml:lang="en-us">Livraria Garnier</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#inst_Garnier_Publisher</IRI>
        <Literal xml:lang="pt-br">Livraria Garnier</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#inst_Local_HD_Server</IRI>
        <Literal xml:lang="pt-br">O hardware físico portador onde reside o arquivo do banco de dados.</Literal>
