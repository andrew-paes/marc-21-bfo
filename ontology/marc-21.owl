        <Literal xml:lang="pt-br">Pessoa</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#person</IRI>
        <Literal xml:lang="en-us">A biological and real human individual. A concrete being that exists in time and retains its own identity over time while undergoing changes.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#person</IRI>
        <Literal xml:lang="pt-br">É o indivíduo humano biológico e real. O ser concreto que existe no tempo que retém sua identidade própria ao longo do tempo enquanto passa por mudanças.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <IRI>#published_by</IRI>
        <Literal xml:lang="pt-br">esta manifestação de 1899 foi publicada_por Editora Garnier.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <IRI>#published_by</IRI>
        <Literal xml:lang="en-us">this 1899 manifestation was published_by Garnier Publisher.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000600"/>
        <IRI>#published_by</IRI>
        <Literal xml:lang="en-us">Binds a publication line to an institutional corporate body that has the legal and operational infrastructure to issue materials.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000600"/>
        <IRI>#published_by</IRI>
        <Literal xml:lang="pt-br">Vincula uma linha de publicação a um corpo corporativo institucional que possui a infraestrutura jurídica e operacional para emitir materiais.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#published_by</IRI>
        <Literal xml:lang="en-us">A relation connecting an informational publication plan (Manifestation) to the organization responsible for its commercial manufacturing and distribution.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#published_by</IRI>
        <Literal xml:lang="pt-br">Uma relação conectando um plano informacional de publicação (Manifestação) à organização responsável por sua manufatura comercial e distribuição.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>#published_by</IRI>
        <Literal xml:lang="pt-br">Publicado por</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>#published_by</IRI>
        <Literal xml:lang="en-us">Published by</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#publisher</IRI>
        <Literal xml:lang="pt-br">Editora</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
