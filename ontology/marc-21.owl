    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#inst_status_cataloged</IRI>
        <Literal xml:lang="pt-br">Ocorre quando o catalogador termina de inserir todas as tags exigidas pela política da instituição, altera o Leader/17 para nível pleno e salva o registro. O sistema o torna visível no catálogo público (OPAC) para os leitores pesquisarem. A qualidade de completude agora inere como completa.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>#inst_status_cataloged</IRI>
        <Literal xml:lang="pt-br">Catalogado</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#inst_status_in_preparation</IRI>
        <Literal xml:lang="pt-br">Ocorre no instante em que o registro provisório é aberto no sistema ou quando o catalogador está digitando as tags. A qualidade de completude ainda é parcial. O registro pertence apenas ao fluxo interno técnico.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>#inst_status_in_preparation</IRI>
        <Literal xml:lang="pt-br">Em Elaboração</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#inst_status_reviewed</IRI>
        <Literal xml:lang="pt-br">O status muda para Revisado após uma auditoria de autoridade (garantir que o nome &quot;Assis, Machado de, 1839-1908&quot; está padronizado exatamente conforme o arquivo de autoridades internacionais).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>#inst_status_reviewed</IRI>
        <Literal xml:lang="pt-br">Revisado</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <IRI>#is_about</IRI>
        <Literal xml:lang="pt-br">este log de registro de empréstimo é_sobre o exemplar do livro físico e é_sobre João o leitor.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <IRI>#is_about</IRI>
        <Literal xml:lang="en-us">this loan record log is_about the physical book copy and is_about Joao the reader.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000600"/>
        <IRI>#is_about</IRI>
        <Literal xml:lang="en-us">A mapping derived from the Information Artifact Ontology (IAO) stating that an informational text or artifact points to, or registers information regarding, a concrete entity.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000600"/>
        <IRI>#is_about</IRI>
        <Literal xml:lang="pt-br">Um mapeamento derivado da Information Artifact Ontology (IAO) estabelecendo que um texto ou artefato informacional aponta para, ou registra informações a respeito de, uma entidade concreta.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#is_about</IRI>
        <Literal xml:lang="en-us">A relation between an information content entity (like a log record) and the real-world independent continuant it references or reports.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#is_about</IRI>
        <Literal xml:lang="pt-br">Uma relação entre uma entidade de conteúdo informacional (como um registro de log) e o continuante independente do mundo real que ela referencia ou relata.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>#is_about</IRI>
        <Literal xml:lang="en-us">Is about</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>#is_about</IRI>
        <Literal xml:lang="pt-br">É sobre</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000600"/>
        <IRI>#is_concretized_in</IRI>
        <Literal xml:lang="en-us">According to BFO, information entities have no mass or space extension; they require a material carrier to be hosted. This relation maps that ontological hosting dependency.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#is_concretized_in</IRI>
        <Literal xml:lang="en-us">A relation between a generically dependent continuant (Information Entity) and the material entity that serves as its hardware or physical carrier.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#is_concretized_in</IRI>
        <Literal xml:lang="pt-br">Uma relação entre um continuante genericamente dependente (Entidade de Informação) e a entidade material que serve como seu hardware ou suporte físico.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>#is_concretized_in</IRI>
        <Literal xml:lang="en-us">Is concretized in</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>#is_concretized_in</IRI>
        <Literal xml:lang="pt-br">É concretizado em</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#library</IRI>
        <Literal xml:lang="pt-br">Biblioteca</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#library</IRI>
        <Literal xml:lang="en-us">Library</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#library</IRI>
        <Literal xml:lang="en-us">A physical institution responsible for the custody, processing, and dissemination of bibliographic collections.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#library</IRI>
        <Literal xml:lang="pt-br">Instituição material responsável pela custódia, processamento e disseminação do acervo bibliográfico.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#loan_record</IRI>
        <Literal xml:lang="en-us">Loan Record</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#loan_record</IRI>
        <Literal xml:lang="pt-br">Registro de Empréstimo</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#loan_record</IRI>
        <Literal xml:lang="en-us">A MARC 21 record that has been textually modified in written form. It is not a free narrative document, but rather structured strings that carry information. An informational piece of log data or transaction record that permanently attests the historical loan transaction between a reader and an item.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#loan_record</IRI>
        <Literal xml:lang="pt-br">Um registro MARC 21 textualmente modificado de forma escrita. Não é documento narrativo livre, mas strings estruturadas que carregam informação. Um artefato informacional ou linha de log que atesta permanentemente a transação histórica de empréstimo ocorrida entre um leitor e um item.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <IRI>#owned_by</IRI>
        <Literal xml:lang="pt-br">este exemplar de livro físico 4567 é propriedade_de a Biblioteca Municipal.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <IRI>#owned_by</IRI>
        <Literal xml:lang="en-us">this physical copy book 4567 is owned_by the City Library.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000600"/>
        <IRI>#owned_by</IRI>
        <Literal xml:lang="pt-br">Mapeia a guarda física e jurídica do mundo real. Uma entidade material independente é propriedade de uma organização social independente.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.obolibrary.org/obo/IAO_0000600"/>
        <IRI>#owned_by</IRI>
        <Literal xml:lang="en-us">Maps real-world physical and legal guardianship. An independent material entity is property of an independent social organization.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#owned_by</IRI>
        <Literal xml:lang="en-us">A relation connecting a physical material object (Item) to the library organization that possesses asset guardianship over it.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#definition"/>
        <IRI>#owned_by</IRI>
        <Literal xml:lang="pt-br">Uma relação conectando um objeto material físico (Item) à organização do tipo biblioteca que possui a guarda patrimonial sobre ele.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>#owned_by</IRI>
        <Literal xml:lang="pt-br">Adquirido por</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://www.w3.org/2004/02/skos/core#prefLabel"/>
        <IRI>#owned_by</IRI>
        <Literal xml:lang="en-us">Owned by</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
