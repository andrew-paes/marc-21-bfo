    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#inst_Dom_Casmurro_1899_Paper_Book</IRI>
        <Literal xml:lang="pt-br">O objeto livro tangível e macroscópico localizado na estante da biblioteca.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
